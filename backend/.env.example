# Application
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Production HTTPS hardening (use HTTPS in deployment)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# PostgreSQL (the intended application database)
DATABASE_URL=
DB_ENGINE=django.db.backends.postgresql
DB_NAME=workneuron
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# JWT lifetimes in minutes/days
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# AI matching
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MATCHING_WEIGHTS_JSON={"semantic":0.45,"skill":0.25,"experience":0.10,"rating":0.05,"availability":0.05,"location":0.05,"reputation":0.05}

# Email defaults for local development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@workneuron.local
NOTIFICATIONS_SEND_EMAIL=False

# Razorpay TEST MODE only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
