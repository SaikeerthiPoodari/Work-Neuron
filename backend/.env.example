# Application
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL (the intended application database)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=workneuron
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# JWT lifetimes in minutes/days
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# Email defaults for local development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@workneuron.local

