VITE_API_URL=http://127.0.0.1:8000/api
VITE_WS_URL=ws://127.0.0.1:8000/ws/notifications/

# Production is injected at build time. For PythonAnywhere's WSGI-only app,
# leave VITE_WS_URL empty unless WebSockets are hosted separately.
# VITE_API_URL=https://<backend-origin>/api
# VITE_WS_URL=wss://<websocket-origin>/ws/notifications/
