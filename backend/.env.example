# Application
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production HTTPS hardening (use HTTPS in deployment)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# PostgreSQL (the intended application database)
DATABASE_URL=
DB_ENGINE=django.db.backends.postgresql
DB_NAME=workneuron
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# JWT lifetimes in minutes/days
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1
API_ANON_RATE=100/day
API_USER_RATE=2000/day
API_SENSITIVE_RATE=30/min

# AI matching
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MATCHING_WEIGHTS_JSON={"semantic":0.40,"skill":0.20,"experience":0.08,"rating":0.04,"availability":0.05,"location":0.08,"reputation":0.04,"education":0.03,"interest":0.02,"job_type":0.03,"salary":0.03}

# Global assistant (optional; fallback guidance remains available without credentials)
AI_PROVIDER=fallback
AI_API_KEY=
AI_MODEL=

# Media storage. Local filesystem is suitable for development only; use private object storage in production.
MEDIA_ROOT=media
MEDIA_URL=/media/
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email defaults for local development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@workneuron.local
NOTIFICATIONS_SEND_EMAIL=False

# Razorpay TEST MODE only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
